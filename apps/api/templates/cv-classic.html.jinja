<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CV Tekteo</title>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Source+Sans+3:ital,wght@0,300;0,400;0,600;1,400&display=swap" rel="stylesheet">
<style>
  :root {
    --tekteo-dark: #1B2A4A;
    --tekteo-blue: #2E5BBA;
    --tekteo-accent: #4A90D9;
    --tekteo-light: #EDF2F9;
    --tekteo-gold: #D4A853;
    --text-primary: #1a1a2e;
    --text-secondary: #555568;
    --text-light: #8888a0;
    --white: #ffffff;
    --border: #dfe3ec;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  @page { size: A4; margin: 0; }

  body {
    font-family: 'Source Sans 3', 'Segoe UI', sans-serif;
    background: #e8e8e8;
    color: var(--text-primary);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .cv-page {
    width: 210mm;
    min-height: 297mm;
    margin: 20px auto;
    background: var(--white);
    box-shadow: 0 4px 24px rgba(0,0,0,0.12);
    overflow: hidden;
    page-break-after: always;
  }

  .cv-page.page-1 {
    display: grid;
    grid-template-columns: 72mm 1fr;
    grid-template-rows: auto 1fr auto;
  }

  .cv-page.page-exp {
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  @media print {
    body { background: white; }
    .cv-page { margin: 0; box-shadow: none; }
  }

  /* ─── HEADER (shared) ─── */
  .header {
    grid-column: 1 / -1;
    background: var(--tekteo-dark);
    color: var(--white);
    padding: 28px 32px 24px;
    display: flex;
    align-items: center;
    gap: 24px;
    position: relative;
    overflow: hidden;
  }

  .header.compact { padding: 18px 32px 16px; }

  .header::before {
    content: '';
    position: absolute;
    top: -40px; right: -40px;
    width: 200px; height: 200px;
    background: var(--tekteo-blue);
    opacity: 0.15;
    border-radius: 50%;
  }

  .header::after {
    content: '';
    position: absolute;
    bottom: -60px; right: 80px;
    width: 140px; height: 140px;
    background: var(--tekteo-gold);
    opacity: 0.08;
    border-radius: 50%;
  }

  .photo-wrapper {
    width: 82px; height: 82px;
    border-radius: 50%;
    border: 3px solid var(--tekteo-gold);
    overflow: hidden;
    flex-shrink: 0;
    background: var(--tekteo-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .photo-wrapper.small {
    width: 48px; height: 48px;
    border-width: 2px;
  }

  .photo-wrapper .initials {
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 28px;
    color: var(--white);
    letter-spacing: 1px;
  }

  .photo-wrapper.small .initials { font-size: 16px; }

  .header-info { position: relative; z-index: 1; }

  .header-info h1 {
    font-family: 'Outfit', sans-serif;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 2px;
  }

  .header.compact .header-info h1 { font-size: 17px; }

  .header-info .title-role {
    font-size: 15px;
    font-weight: 300;
    color: var(--tekteo-accent);
    letter-spacing: 0.3px;
  }

  .header.compact .header-info .title-role { font-size: 11.5px; }

  .header-info .subtitle {
    font-size: 12px;
    color: rgba(255,255,255,0.55);
    margin-top: 4px;
    font-weight: 300;
  }

  .tekteo-logo {
    margin-left: auto;
    position: relative;
    z-index: 1;
    text-align: right;
  }

  .tekteo-logo .logo-text {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 2px;
    color: var(--white);
  }

  .header.compact .tekteo-logo .logo-text { font-size: 15px; letter-spacing: 1.5px; }

  .tekteo-logo .logo-sub {
    font-size: 9px;
    color: rgba(255,255,255,0.45);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-top: 1px;
  }

  /* ─── SIDEBAR ─── */
  .sidebar {
    background: var(--tekteo-light);
    padding: 24px 18px 32px;
    border-right: 1px solid var(--border);
  }

  .sidebar-section { margin-bottom: 22px; }

  .sidebar-section-title {
    font-family: 'Outfit', sans-serif;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: var(--tekteo-blue);
    margin-bottom: 12px;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--tekteo-blue);
    display: inline-block;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 8px;
    font-size: 11.5px;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .contact-icon {
    width: 16px; height: 16px;
    fill: var(--tekteo-blue);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .skill-item { margin-bottom: 10px; }

  .skill-name {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .skill-bar {
    height: 5px;
    background: rgba(46,91,186,0.12);
    border-radius: 3px;
    overflow: hidden;
  }

  .skill-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--tekteo-blue), var(--tekteo-accent));
    border-radius: 3px;
  }

  .tag-list { display: flex; flex-wrap: wrap; gap: 5px; }

  .tag {
    font-size: 10px;
    padding: 3px 8px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .lang-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 7px;
    font-size: 11.5px;
  }

  .lang-name { font-weight: 600; color: var(--text-primary); }
  .lang-level { font-size: 10px; color: var(--text-light); font-weight: 400; }

  .lang-dots { display: flex; gap: 3px; }

  .lang-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: rgba(46,91,186,0.15);
  }

  .lang-dot.filled { background: var(--tekteo-blue); }

  .cert-item {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 7px;
    font-size: 11.5px;
  }

  .cert-badge {
    width: 20px; height: 20px;
    background: var(--tekteo-light);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cert-badge svg { width: 12px; height: 12px; fill: var(--tekteo-blue); }
  .cert-name { font-weight: 500; }
  .cert-year { color: var(--text-light); font-size: 10px; margin-left: 4px; }

  /* ─── MAIN CONTENT ─── */
  .main { padding: 24px 28px 32px; }

  .section { margin-bottom: 22px; }

  .section-title {
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--tekteo-dark);
    margin-bottom: 14px;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--tekteo-gold);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .section-title::before {
    content: '';
    width: 6px; height: 6px;
    background: var(--tekteo-gold);
    border-radius: 1px;
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  /* ─── SUMMARY EXPERIENCES (page 1) ─── */
  .exp-summary {
    margin-bottom: 10px;
    padding: 10px 12px;
    background: var(--white);
    border-left: 3px solid var(--tekteo-blue);
    border-bottom: 1px solid var(--border);
    border-radius: 0 4px 4px 0;
    position: relative;
  }

  .exp-summary-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 2px;
  }

  .exp-summary-role {
    font-weight: 600;
    font-size: 12.5px;
    color: var(--text-primary);
  }

  .exp-summary-dates {
    font-size: 10px;
    color: var(--tekteo-blue);
    font-weight: 600;
    white-space: nowrap;
  }

  .exp-summary-company {
    font-size: 11px;
    color: var(--tekteo-accent);
    font-weight: 600;
    margin-bottom: 4px;
  }

  .exp-summary-desc {
    font-size: 10.5px;
    color: var(--text-secondary);
    line-height: 1.45;
    margin-bottom: 5px;
  }

  .exp-summary-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
  }

  .exp-summary-tag {
    font-size: 9px;
    padding: 2px 6px;
    background: var(--tekteo-light);
    color: var(--tekteo-blue);
    border-radius: 2px;
    font-weight: 600;
    letter-spacing: 0.3px;
  }

  .exp-page-ref {
    position: absolute;
    top: 10px; right: 12px;
    font-size: 8.5px;
    color: var(--text-light);
    font-weight: 500;
    font-style: italic;
  }

  /* Education */
  .edu-item { margin-bottom: 12px; }

  .edu-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .edu-degree { font-weight: 600; font-size: 12.5px; color: var(--text-primary); }
  .edu-year { font-size: 10px; color: var(--tekteo-blue); font-weight: 600; }
  .edu-school { font-size: 11px; color: var(--text-secondary); }

  /* ─── DETAIL PAGE (subsequent pages) ─── */
  .exp-detail-content {
    padding: 28px 40px 20px;
  }

  .exp-detail-hero {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 16px;
    margin-bottom: 20px;
    border-bottom: 2px solid var(--tekteo-gold);
    gap: 24px;
  }

  .exp-detail-hero-left { flex: 1; }

  .exp-detail-number {
    font-family: 'Outfit', sans-serif;
    font-size: 11px;
    font-weight: 600;
    color: var(--tekteo-gold);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .exp-detail-role {
    font-family: 'Outfit', sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: var(--tekteo-dark);
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .exp-detail-company {
    font-size: 14px;
    color: var(--tekteo-blue);
    font-weight: 600;
    margin-bottom: 2px;
  }

  .exp-detail-client-meta {
    font-size: 11px;
    color: var(--text-light);
    font-style: italic;
  }

  .exp-detail-meta {
    text-align: right;
    flex-shrink: 0;
  }

  .exp-detail-dates {
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: var(--tekteo-dark);
    margin-bottom: 2px;
  }

  .exp-detail-duration {
    display: inline-block;
    font-size: 10px;
    padding: 3px 10px;
    background: var(--tekteo-light);
    color: var(--tekteo-blue);
    border-radius: 10px;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .exp-detail-location {
    font-size: 10.5px;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 4px;
    justify-content: flex-end;
  }

  .exp-detail-block { margin-bottom: 18px; }

  .exp-detail-label {
    font-family: 'Outfit', sans-serif;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: var(--tekteo-blue);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .exp-detail-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--tekteo-blue), transparent);
    opacity: 0.3;
  }

  .exp-detail-text {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .exp-detail-list {
    list-style: none;
    padding: 0;
  }

  .exp-detail-list li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 7px;
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .exp-detail-list li::before {
    content: '';
    position: absolute;
    left: 0; top: 7px;
    width: 8px; height: 8px;
    background: var(--tekteo-gold);
    transform: rotate(45deg);
    border-radius: 1px;
  }

  .exp-detail-list li strong {
    color: var(--tekteo-dark);
    font-weight: 600;
  }

  /* Achievements grid */
  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 4px;
  }

  .achievement-card {
    background: linear-gradient(135deg, var(--tekteo-light) 0%, rgba(255,255,255,0.5) 100%);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    border-top: 3px solid var(--tekteo-gold);
  }

  .achievement-value {
    font-family: 'Outfit', sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: var(--tekteo-dark);
    line-height: 1;
    margin-bottom: 4px;
  }

  .achievement-label {
    font-size: 10px;
    color: var(--text-secondary);
    line-height: 1.3;
  }

  /* Tech stack grid */
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 6px 16px;
  }

  .tech-category {
    display: flex;
    gap: 6px;
    align-items: baseline;
    font-size: 11px;
    padding: 3px 0;
  }

  .tech-category-label {
    font-weight: 700;
    color: var(--tekteo-dark);
    min-width: 70px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .tech-category-items {
    color: var(--text-secondary);
    font-size: 11px;
  }

  /* Context info box */
  .context-box {
    background: var(--tekteo-light);
    border-left: 3px solid var(--tekteo-blue);
    padding: 10px 14px;
    border-radius: 0 4px 4px 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .context-item { font-size: 10.5px; }

  .context-item-label {
    font-size: 9px;
    color: var(--tekteo-blue);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 2px;
  }

  .context-item-value {
    color: var(--text-primary);
    font-weight: 600;
    font-size: 11px;
  }

  /* ─── FOOTER ─── */
  .footer {
    grid-column: 1 / -1;
    background: var(--tekteo-dark);
    padding: 8px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-text {
    font-size: 8.5px;
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.5px;
  }

  .footer-line {
    height: 2px;
    flex: 1;
    margin: 0 16px;
    background: linear-gradient(90deg, var(--tekteo-blue), var(--tekteo-gold));
    opacity: 0.3;
    border-radius: 1px;
  }

  .page-number {
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    color: rgba(255,255,255,0.6);
    font-size: 9px;
    letter-spacing: 1px;
  }
</style>
</head>
<body>

<!-- ═══════════════════════════════════════════════ -->
<!-- PAGE 1 — SOMMAIRE                               -->
<!-- ═══════════════════════════════════════════════ -->
<div class="cv-page page-1">

  {% set initials = identity.initials or ((identity.firstName[:1] ~ identity.lastName[:1]) | upper) %}
  {% set total_pages = experiences|length + 1 %}
  <div class="header">
    <div class="photo-wrapper">
      <span class="initials">{{ initials }}</span>
    </div>
    <div class="header-info">
      <h1>{{ identity.firstName }} {{ identity.lastName }}</h1>
      {% if identity.role %}<div class="title-role">{{ identity.role }}</div>{% endif %}
      {% if identity.subtitle %}<div class="subtitle">{{ identity.subtitle }}</div>{% endif %}
    </div>
    <div class="tekteo-logo">
      <div class="logo-text">TEKTEO</div>
      <div class="logo-sub">Services du numérique</div>
    </div>
  </div>

  <div class="sidebar">
    <div class="sidebar-section">
      <div class="sidebar-section-title">Contact</div>
      {% if identity.email %}
      <div class="contact-item">
        <svg class="contact-icon" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
        <span>{{ identity.email }}</span>
      </div>
      {% endif %}
      {% if identity.phone %}
      <div class="contact-item">
        <svg class="contact-icon" viewBox="0 0 24 24"><path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.07 21 3 13.93 3 4c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.46.57 3.58.11.35.03.74-.24 1.01l-2.21 2.2z"/></svg>
        <span>{{ identity.phone }}</span>
      </div>
      {% endif %}
      {% if identity.location %}
      <div class="contact-item">
        <svg class="contact-icon" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>
        <span>{{ identity.location }}</span>
      </div>
      {% endif %}
      {% if identity.linkedin %}
      <div class="contact-item">
        <svg class="contact-icon" viewBox="0 0 24 24"><path d="M19 3a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h14m-.5 15.5v-5.3a3.26 3.26 0 00-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 011.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 001.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 00-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
        <span>{{ identity.linkedin }}</span>
      </div>
      {% endif %}
    </div>

    {% if skills %}
    <div class="sidebar-section">
      <div class="sidebar-section-title">Compétences</div>
      {% for skill in skills %}
      <div class="skill-item">
        <div class="skill-name">{{ skill.name }}</div>
        <div class="skill-bar"><div class="skill-fill" style="width: {{ skill.level }}%"></div></div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if tools %}
    <div class="sidebar-section">
      <div class="sidebar-section-title">Outils</div>
      <div class="tag-list">
        {% for tool in tools %}<span class="tag">{{ tool }}</span>{% endfor %}
      </div>
    </div>
    {% endif %}

    {% if languages %}
    <div class="sidebar-section">
      <div class="sidebar-section-title">Langues</div>
      {% for lang in languages %}
      <div class="lang-item">
        <div><span class="lang-name">{{ lang.name }}</span>{% if lang.levelLabel %}<span class="lang-level"> · {{ lang.levelLabel }}</span>{% endif %}</div>
        <div class="lang-dots">
          {% for i in range(1, 6) %}<div class="lang-dot{% if i <= lang.dots %} filled{% endif %}"></div>{% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if certifications %}
    <div class="sidebar-section">
      <div class="sidebar-section-title">Certifications</div>
      {% for cert in certifications %}
      <div class="cert-item">
        <div class="cert-badge"><svg viewBox="0 0 24 24"><path d="M12 2L9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2z"/></svg></div>
        <div><span class="cert-name">{{ cert.name }}</span>{% if cert.year %}<span class="cert-year">{{ cert.year }}</span>{% endif %}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>

  <div class="main">
    {% if experiences %}
    <div class="section">
      <div class="section-title">Synthèse des expériences</div>
      {% for exp in experiences %}
      <div class="exp-summary">
        <div class="exp-page-ref">voir p. {{ loop.index + 1 }}</div>
        <div class="exp-summary-header">
          <span class="exp-summary-role">{{ exp.role }}</span>
          <span class="exp-summary-dates">{{ exp.dateStart }}{% if exp.dateEnd %} — {{ exp.dateEnd }}{% endif %}</span>
        </div>
        {% if exp.company %}<div class="exp-summary-company">{{ exp.company }}{% if exp.clientMeta %} · {{ exp.clientMeta }}{% endif %}</div>{% endif %}
        {% if exp.mission %}<div class="exp-summary-desc">{{ exp.mission }}</div>{% endif %}
        {% if exp.tech %}
        <div class="exp-summary-tags">
          {% for t in exp.tech %}<span class="exp-summary-tag">{{ t['items'].split(',')[0] | trim }}</span>{% endfor %}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if education %}
    <div class="section">
      <div class="section-title">Formation</div>
      {% for edu in education %}
      <div class="edu-item">
        <div class="edu-header">
          <span class="edu-degree">{{ edu.degree }}</span>
          {% if edu.year %}<span class="edu-year">{{ edu.year }}</span>{% endif %}
        </div>
        {% if edu.school %}<div class="edu-school">{{ edu.school }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>

  <div class="footer">
    <span class="footer-text">TEKTEO · ESN</span>
    <div class="footer-line"></div>
    <span class="page-number">01 / {{ '%02d' % total_pages }}</span>
  </div>
</div>


{% for exp in experiences %}
<!-- ═══════════════════════════════════════════════ -->
<!-- PAGE {{ '%02d' % (loop.index + 1) }} — EXPÉRIENCE #{{ '%02d' % loop.index }} -->
<!-- ═══════════════════════════════════════════════ -->
<div class="cv-page page-exp">

  <div class="header compact">
    <div class="photo-wrapper small"><span class="initials">{{ initials }}</span></div>
    <div class="header-info">
      <h1>{{ identity.firstName }} {{ identity.lastName }}</h1>
      {% if identity.role %}<div class="title-role">{{ identity.role }}</div>{% endif %}
    </div>
    <div class="tekteo-logo">
      <div class="logo-text">TEKTEO</div>
      <div class="logo-sub">Services du numérique</div>
    </div>
  </div>

  <div class="exp-detail-content">

    <div class="exp-detail-hero">
      <div class="exp-detail-hero-left">
        <div class="exp-detail-number">Expérience {{ '%02d' % loop.index }}</div>
        <div class="exp-detail-role">{{ exp.role }}</div>
        {% if exp.company %}<div class="exp-detail-company">{{ exp.company }}</div>{% endif %}
        {% if exp.clientMeta %}<div class="exp-detail-client-meta">{{ exp.clientMeta }}</div>{% endif %}
      </div>
      <div class="exp-detail-meta">
        <div class="exp-detail-dates">{{ exp.dateStart }}{% if exp.dateEnd %} — {{ exp.dateEnd }}{% endif %}</div>
        {% if exp.duration %}<div class="exp-detail-duration">{{ exp.duration }}</div>{% endif %}
        {% if exp.location %}<div class="exp-detail-location">📍 {{ exp.location }}</div>{% endif %}
      </div>
    </div>

    {% set ctx = exp.context %}
    {% if ctx and (ctx.team or ctx.methodology or ctx.role or ctx.extraValue) %}
    <div class="exp-detail-block">
      <div class="exp-detail-label">Contexte</div>
      <div class="context-box">
        {% if ctx.team %}
        <div class="context-item">
          <div class="context-item-label">Équipe</div>
          <div class="context-item-value">{{ ctx.team }}</div>
        </div>
        {% endif %}
        {% if ctx.methodology %}
        <div class="context-item">
          <div class="context-item-label">Méthodologie</div>
          <div class="context-item-value">{{ ctx.methodology }}</div>
        </div>
        {% endif %}
        {% if ctx.role %}
        <div class="context-item">
          <div class="context-item-label">Rôle</div>
          <div class="context-item-value">{{ ctx.role }}</div>
        </div>
        {% endif %}
        {% if ctx.extraValue %}
        <div class="context-item">
          <div class="context-item-label">{{ ctx.extraLabel or 'Domaine' }}</div>
          <div class="context-item-value">{{ ctx.extraValue }}</div>
        </div>
        {% endif %}
      </div>
    </div>
    {% endif %}

    {% if exp.mission %}
    <div class="exp-detail-block">
      <div class="exp-detail-label">Mission</div>
      <p class="exp-detail-text">
        {{ exp.mission }}
      </p>
    </div>
    {% endif %}

    {% if exp.activities %}
    <div class="exp-detail-block">
      <div class="exp-detail-label">Activités réalisées</div>
      <ul class="exp-detail-list">
        {% for activity in exp.activities %}
        <li>{% if activity.bold %}<strong>{{ activity.bold }} :</strong> {% endif %}{{ activity.text }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if exp.results %}
    <div class="exp-detail-block">
      <div class="exp-detail-label">Résultats</div>
      <div class="achievements-grid">
        {% for result in exp.results %}
        <div class="achievement-card">
          <div class="achievement-value">{{ result.value }}</div>
          <div class="achievement-label">{{ result.label }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if exp.tech %}
    <div class="exp-detail-block">
      <div class="exp-detail-label">Environnement technique</div>
      <div class="tech-grid">
        {% for t in exp.tech %}
        <div class="tech-category">
          <span class="tech-category-label">{{ t.category }}</span>
          <span class="tech-category-items">{{ t['items'] }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>

  <div class="footer">
    <span class="footer-text">TEKTEO · ESN</span>
    <div class="footer-line"></div>
    <span class="page-number">{{ '%02d' % (loop.index + 1) }} / {{ '%02d' % total_pages }}</span>
  </div>
</div>
{% endfor %}

</body>
</html>
