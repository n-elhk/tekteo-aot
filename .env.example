# ============================================================
# Node
# ============================================================
NODE_ENV=development

# ============================================================
# Backend (apps/api) — read at runtime by @nestjs/config
# ============================================================
PORT=3000
FRONT_URL=https://localhost:4200
CORS_ORIGIN=https://localhost:4200

# ============================================================
# Database (PostgreSQL)
# ============================================================
DATABASE_URL=postgresql://tekteo:tekteo@localhost:5432/tekteo?schema=public

# ============================================================
# JWT
# ============================================================
JWT_ACCESS_SECRET=change-me-access-secret-256-bits
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-256-bits
JWT_REFRESH_TTL=7d

# ============================================================
# Cookies
# ============================================================
COOKIE_DOMAIN=localhost

# ============================================================
# Anthropic Claude (génération IA des sections)
# ============================================================
# Clé API Anthropic — laisser vide pour désactiver la génération
ANTHROPIC_API_KEY=

# ============================================================
# Storage local (Option A : filesystem)
# ============================================================
# Répertoire où sont stockés les fichiers uploadés (DCE, mémoires, etc.)
UPLOADS_DIR=apps/api/uploads

# ============================================================
# Worker CV (NestJS → worker Python)
# ============================================================
CV_WORKER_URL=http://localhost:8000

# ============================================================
# Runtime LLM (côté worker — abstraction OpenAI-compat)
# ============================================================
# Ollama par défaut. Pour basculer vers vLLM/llama.cpp/etc.,
# changer le service Docker et ces deux valeurs uniquement.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=mistral:7b-instruct
LLM_API_KEY=not-needed

# ============================================================
# Redis / BullMQ (queue d'imports CV)
# ============================================================
REDIS_URL=redis://localhost:6379
